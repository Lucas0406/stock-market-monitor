# Supabase (Acesse Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Brapi (Crie sua conta gratuita em https://brapi.dev para obter seu token)
BRAPI_TOKEN="your-brapi-token-here"

# Resend (Obtenha em https://resend.com/api-keys)
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Segredo de segurança para a chamada do pg_cron para a Edge Function
CRON_SECRET="your-strong-random-cron-secret-here"

# URL da aplicação (para redirecionamentos OAuth do Supabase)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
